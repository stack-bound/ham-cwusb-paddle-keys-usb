# paddlekeys: start the service when the HAM CWUSB adapter is plugged in and
# stop it when it is removed. The SYSTEMD_ALIAS gives the USB device a stable
# unit name (dev-paddlekeys.device) that paddlekeys.service binds to.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="34bf", ATTR{idProduct}=="ff0b", \
    TAG+="systemd", ENV{SYSTEMD_ALIAS}="/dev/paddlekeys", ENV{SYSTEMD_WANTS}="paddlekeys.service"

# Let the input group write to /dev/uinput so the service (and anyone in the
# input group running paddlekeys by hand) can create the virtual keyboard.
KERNEL=="uinput", GROUP="input", MODE="0660", OPTIONS+="static_node=uinput"
